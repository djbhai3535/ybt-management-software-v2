# ==============================================================================
# DJ CRM Software 5.1 — Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. On your Hostinger server, copy this file as: .env
# 2. Place .env directly in public_html/ alongside index.php (or parent directory)
# 3. Enter your database username, database password, and Gmail App Password
# 4. NEVER commit or expose your actual .env file publicly!
# ==============================================================================

# Application Environment
APP_NAME="DJ CRM Software"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://apkashow.com
APP_TIMEZONE=Asia/Karachi

# Database Configuration (Hostinger MySQL / MariaDB)
# DB_HOST is usually 'localhost' or '127.0.0.1' on Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u290903472_djcrm
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Transactional Email (Gmail SMTP with SSL on Port 465)
# NOTE: For Gmail, use an "App Password" (16 characters), NOT your account login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DJ CRM Software"

# Central Cloud & Multi-Tenant Sync
CLOUD_SYNC_URL=https://apkashow.com
WHATSAPP_SUPPORT_NUMBER=923000000000

# Security & Data-at-Rest Encryption Key
# Generate a 32-character random string (e.g. via: bin2hex(random_bytes(16)))
YBT_ENCRYPTION_KEY=
